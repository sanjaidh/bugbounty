# ─── CyberCarnival Environment Variables ─────────────────────────────────────

# Neon (PostgreSQL) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/cybercarnival?sslmode=require"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX"

# HMAC secret for final-stage unique flag generation
FLAG_SECRET="REPLACE_WITH_64_CHAR_HEX"

# One-time key used to bootstrap the first admin account via POST /api/admin/bootstrap
ADMIN_SETUP_KEY="REPLACE_WITH_RANDOM_STRING"

# Shop name used in stage 5 (must match your Vercel mini-app subdomain)
# e.g. if your shop is "pixelbrew", deploy secret-site to pixelbrew.vercel.app
CHALLENGE_SHOP_NAME="pixelbrew"

# IP address for stage 6 NMAP challenge (your VPS or local tunneled machine)
CHALLENGE_IP="YOUR_VPS_IP_HERE"

# Google Drive URLs (set these after uploading your assets)
CHALLENGE_DRIVE_MEME_URL="https://drive.google.com/..."
CHALLENGE_DRIVE_VIDEO_URL="https://drive.google.com/..."

# GitHub de-pixelate notebook URL (stage 8)
CHALLENGE_GITHUB_NOTEBOOK="https://github.com/KoKuToru/de-pixelate_gaV-O6NPWrl/blob/master/example/mosaic-area.ipynb"

# GPS coordinates embedded in the monkey meme (stage 3)
CHALLENGE_GPS_LAT="12.9716"
CHALLENGE_GPS_LNG="77.5946"

# Competition window (IST = UTC+5:30)
COMPETITION_START="2026-10-08T04:30:00.000Z"
COMPETITION_END="2026-10-08T18:30:00.000Z"

# Runtime
NODE_ENV="development"
PORT="3001"
CLIENT_URL="http://localhost:5173"
